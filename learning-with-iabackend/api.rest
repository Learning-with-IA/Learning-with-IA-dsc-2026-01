@baseUrl = http://localhost:3000

# ============================================
# USERS MODULE - REST Client Tests
# ============================================

### [CREATE USER 1]
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "João Silva",
  "email": "joao@example.com",
  "password": "senha123",
  "phone": "11999999999"
}

### [CREATE USER 2]
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Maria Santos",
  "email": "maria@example.com",
  "password": "senha456",
  "phone": "11988888888"
}

### [READ ALL USERS]
GET {{baseUrl}}/users

### [READ USER BY ID 1 - Registro existente]
# Status esperado: 200 OK
# Copie o id de um usuário criado acima
@userId = 1
GET {{baseUrl}}/users/{{userId}}

### [READ USER BY ID 2 - Registro inexistente]
# Status esperado: 404 Not Found
# Retorna erro descriptivo
GET {{baseUrl}}/users/99999

### [UPDATE USER]
# Use o GET por ID antes e depois para confirmar persistência
@userId = 1
PATCH {{baseUrl}}/users/{{userId}}
Content-Type: application/json

{
  "name": "João Silva Atualizado",
  "phone": "11977777777"
}

### [DELETE USER]
@userId = 2
DELETE {{baseUrl}}/users/{{userId}}

